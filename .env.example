# OmniDownload Environment Configuration

# Application
APP_NAME=OmniDownload
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Directories
DOWNLOAD_DIR=./downloads
TEMP_DIR=./temp

# Download Limits
MAX_FILE_SIZE=10737418240  # 10GB in bytes
MAX_CONCURRENT_DOWNLOADS=2
DEFAULT_RETRIES=3
REQUEST_TIMEOUT=30

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/omnidownload.db

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# User Agent
USER_AGENT=OmniDownload/1.0.0 (+https://github.com/omnidownload)